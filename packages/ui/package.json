{
    "name": "@every-where/ui",
    "version": "0.1.0",
    "author": "mkMuTou",
    "description": "web component ui library",
    "keywords": [
        "web-components",
        "lit",
        "ui-library",
        "typescript",
        "less",
        "vite",
        "ui",
        "component"
    ],
    "type": "module",
    "types": "./dist/index.d.ts",
    "main": "./dist/umd/index.cjs",
    "module": "./dist/es/index.js",
    "exports": {
        ".": {
            "import": "./dist/es/index.js",
            "require": "./dist/umd/index.cjs",
            "types": "./dist/types/index.d.ts"
        },
        "./*": {
            "import": "./dist/es/components/*/*.js",
            "types": "./dist/types/components/*/*.d.ts"
        },
        "./theme": {
            "import": "./dist/es/utils/theme",
            "types": "./dist/types/utils/theme.d.ts"
        },
        "./styles": "./dist/es/ui.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build:esm": "vite build",
        "build:umd": "vite build --config vite.config.umd.ts",
        "build": "npm run build:esm && npm run build:umd"
    },
    "dependencies": {
        "async-validator": "^4.2.5",
        "lit": "^3.3.1",
        "mitt": "^3.0.1"
    },
    "devDependencies": {
        "@types/less": "^3.0.8",
        "@types/node": "^24.10.1",
        "@types/postcss-pxtorem": "^6.1.0",
        "autoprefixer": "^10.4.23",
        "less": "^4.4.2",
        "postcss": "^8.5.6",
        "postcss-less": "^6.0.0",
        "postcss-pxtorem": "^6.1.0",
        "tslib": "^2.8.1",
        "typescript": "~5.9.3",
        "vite": "^7.2.4",
        "vite-plugin-dts": "^4.5.4"
    }
}
