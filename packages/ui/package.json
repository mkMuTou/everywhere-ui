{
    "name": "@every-where/ui",
    "version": "0.1.0",
    "author": "mkMuTou",
    "description": "web component ui library",
    "keywords": [
        "web-components",
        "lit",
        "ui-library",
        "typescript",
        "less",
        "vite",
        "ui",
        "component"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "types": "./dist/types/index.d.ts"
        },
        "./styles": "./dist/ui.css",
        "./components/*": "./dist/components/*.js",
        "./theme":{
            "import":"./dist/theme.js",
            "types":"./dist/types/utils/theme.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build"
    },
    "dependencies": {
        "async-validator": "^4.2.5",
        "lit": "^3.3.1",
        "mitt": "^3.0.1"
    },
    "devDependencies": {
        "@types/less": "^3.0.8",
        "@types/node": "^24.10.1",
        "@types/postcss-pxtorem": "^6.1.0",
        "autoprefixer": "^10.4.23",
        "less": "^4.4.2",
        "postcss": "^8.5.6",
        "postcss-less": "^6.0.0",
        "postcss-pxtorem": "^6.1.0",
        "tslib": "^2.8.1",
        "typescript": "~5.9.3",
        "vite": "^7.2.4",
        "vite-plugin-dts": "^4.5.4"
    }
}
